# --- SUPABASE AUTHENTICATION & REST API ---
# Project reference: jxdsgzwdwoscyqrowsde
SUPABASE_URL=https://jxdsgzwdwoscyqrowsde.supabase.co
# Found in: Project Settings -> API -> anon public / service_role secret
SUPABASE_KEY=

# --- SUPABASE POSTGRESQL DIRECT DATABASE STORAGE (Option B) ---
# Recommended: Connection Pooler URI (Port 6543, supports IPv4 globally)
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Example: postgresql://postgres.jxdsgzwdwoscyqrowsde:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Alternative discrete parameters (if not using DATABASE_URL connection string)
SUPABASE_HOST=db.jxdsgzwdwoscyqrowsde.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=

# --- ALERTING & NOTIFICATION CHANNELS (Optional) ---
SLACK_WEBHOOK_URL=
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
